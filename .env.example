# MySQL Docker
MYSQL_PORT=3307
MYSQL_DATABASE=bxconnect_mvp1
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

# Compte utilisé par BX-Connect
DB_USERNAME=bxconnect
DB_PASSWORD=replace-with-a-strong-application-password

# Connexion du backend lancé depuis le Mac
SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3307/bxconnect_mvp1?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true"
SPRING_DATASOURCE_USERNAME=bxconnect
