VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=<NOM_ENVIRONNEMENT>
VITE_SENTRY_RELEASE=
VITE_SENTRY_DIST=
VITE_ANALYTICS_KEY=
