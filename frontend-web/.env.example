# Public client configuration only. Never place secrets in VITE_* variables.
# Local development example. Deployment builds require an explicit, non-local HTTPS URL.
VITE_API_BASE_URL=http://localhost:8080/api

# Optional observability. Leave empty until a public client-side configuration is approved.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=<NOM_ENVIRONNEMENT>
VITE_SENTRY_RELEASE=
VITE_SENTRY_DIST=
VITE_ANALYTICS_KEY=
