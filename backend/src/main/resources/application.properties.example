# BX-CONNECT - Exemple de configuration
# Copiez en application.properties
server.port=8080
spring.datasource.url=jdbc:mysql://localhost:3306/bxconnect_mvp1?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=${DB_PASSWORD:CHANGE_ME}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update

# Donnees partenaires de demonstration (desactivees par defaut)
bx.demo.partners.enabled=${BX_DEMO_PARTNERS_ENABLED:false}
bx.demo.partners.password=${BX_DEMO_PARTNERS_PASSWORD:DemoPartner123!}
spring.jpa.show-sql=false
jwt.secret=${JWT_SECRET:CHANGE_ME}
jwt.expiration=86400000
frontend.url=http://localhost:5173
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
paypal.client-id=${PAYPAL_CLIENT_ID:CHANGE_ME}
paypal.client-secret=${PAYPAL_CLIENT_SECRET:CHANGE_ME}
paypal.mode=sandbox
paypal.return-url=http://localhost:8080/api/paiements/confirmer
paypal.cancel-url=http://localhost:8080/api/paiements/annuler
stripe.secret-key=${STRIPE_SECRET_KEY:CHANGE_ME}
stripe.publishable-key=${STRIPE_PUBLISHABLE_KEY:CHANGE_ME}
stripe.webhook-secret=${STRIPE_WEBHOOK_SECRET:CHANGE_ME}
stripe.success-url=http://localhost:5173/paiement/succes
stripe.cancel-url=http://localhost:5173/paiement/annule

# Expo Push Service (token d'acces facultatif si la securite renforcee Expo est desactivee)
bx.push.expo-url=${EXPO_PUSH_URL:https://exp.host/--/api/v2/push/send}
bx.push.access-token=${EXPO_PUSH_ACCESS_TOKEN:}
