# BX-CONNECT — exemple non fonctionnel de configuration.
# Ne placez aucune valeur réelle dans ce fichier. Fournissez-les par l'environnement.

server.port=${SERVER_PORT:8080}
spring.profiles.active=${SPRING_PROFILES_ACTIVE}

# Base de données
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA et Flyway — les migrations SQL restent versionnées.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.validate-on-migrate=true
spring.flyway.baseline-on-migrate=false
spring.flyway.clean-disabled=true

# Authentification et bootstrap
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION:86400000}
bx.super-admin.email=${BX_SUPER_ADMIN_EMAIL}
bx.super-admin.password=${BX_SUPER_ADMIN_PASSWORD}
bx.super-admin.prenom=${BX_SUPER_ADMIN_PRENOM}
bx.super-admin.nom=${BX_SUPER_ADMIN_NOM}

# URLs et CORS
frontend.url=${FRONTEND_URL}
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS}
bx.production=${BX_PRODUCTION:false}

# Les paiements sont désactivés par défaut.
features.payments.stripe.enabled=${FEATURES_PAYMENTS_STRIPE_ENABLED:false}
features.payments.paypal.enabled=${FEATURES_PAYMENTS_PAYPAL_ENABLED:false}
paypal.client-id=${PAYPAL_CLIENT_ID:}
paypal.client-secret=${PAYPAL_CLIENT_SECRET:}
paypal.mode=${PAYPAL_MODE:sandbox}
paypal.return-url=${PAYPAL_RETURN_URL}
paypal.cancel-url=${PAYPAL_CANCEL_URL}
stripe.secret-key=${STRIPE_SECRET_KEY:}
stripe.publishable-key=${STRIPE_PUBLISHABLE_KEY:}
stripe.webhook-secret=${STRIPE_WEBHOOK_SECRET:}
stripe.success-url=${STRIPE_SUCCESS_URL}
stripe.cancel-url=${STRIPE_CANCEL_URL}

# Expo Push Service
bx.push.expo-url=${EXPO_PUSH_URL:https://exp.host/--/api/v2/push/send}
bx.push.access-token=${EXPO_PUSH_ACCESS_TOKEN:}

# Récupération de mot de passe et SMTP
app.password-reset.email-enabled=${PASSWORD_RESET_EMAIL_ENABLED:false}
app.password-reset.token-ttl=${PASSWORD_RESET_TOKEN_TTL:PT15M}
app.password-reset.frontend-url=${PASSWORD_RESET_FRONTEND_URL}
app.password-reset.from-address=${PASSWORD_RESET_FROM_ADDRESS}
spring.mail.host=${MAIL_HOST}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
