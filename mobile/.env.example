# EXPO_PUBLIC_* values are embedded in the client application and are never secret.
# Replace the placeholder with an API URL reachable from the device or emulator.
EXPO_PUBLIC_API_BASE_URL=<URL_API_ACCESSIBLE_DEPUIS_LE_MOBILE>

# Optional observability. Leave empty until a public mobile configuration is approved.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=<NOM_ENVIRONNEMENT>
EXPO_PUBLIC_SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_DIST=
EXPO_PUBLIC_ANALYTICS_KEY=
